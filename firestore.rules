rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper to check user ownership
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper to check if user has active Pro subscription
    function isProUser() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'pro';
    }

    // Regras para perfil de usuário
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Regras para repertórios / setlists na nuvem
    match /setlists/{setlistId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && (isProUser() || request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Regras para salas ao vivo (Live Rooms)
    match /rooms/{roomId} {
      allow read: if true; // Qualquer membro da banda com o código PIN pode ler a sala
      allow create: if isProUser(); // Apenas assinantes Pro podem criar salas de ensaio como Líder
      allow update: if isAuthenticated() && (resource.data.hostId == request.auth.uid || isProUser());
      allow delete: if isAuthenticated() && resource.data.hostId == request.auth.uid;
    }

    // Catálogo público de músicas
    match /songs/{songId} {
      allow read: if true;
      allow write: if false; // Apenas administradores via Firebase Console
    }
  }
}
