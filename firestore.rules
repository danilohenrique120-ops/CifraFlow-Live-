rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper to check user ownership
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper to check if user has active Pro subscription
    function isProUser() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'pro';
    }

    // Regras para perfil e dados do usuário na nuvem
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Regras para repertórios / setlists na nuvem
    match /setlists/{setlistId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && (isProUser() || request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Regras para salas ao vivo (Live Rooms)
    match /rooms/{roomId} {
      allow read: if true; // Qualquer membro da banda com o código PIN pode ler a sala
      allow create: if isAuthenticated() || isProUser(); // Usuários podem criar salas
      allow update: if true; // Qualquer integrante da sala pode sincronizar tom, músicas, rolagem e status de mídia
      allow delete: if isAuthenticated() && resource.data.hostId == request.auth.uid;

      // Subcoleção para sinalização WebRTC de áudio e vídeo entre os músicos
      match /signals/{signalId} {
        allow read, write: if true;
      }
    }

    // Regras para repertórios compartilhados (links públicos / códigos PIN)
    match /shared_setlists/{shareCode} {
      allow read: if true; // Qualquer pessoa com o link ou código pode ler e importar
      allow write: if true; // Permite publicar repertórios para a banda
    }

    // Catálogo público de músicas
    match /songs/{songId} {
      allow read: if true;
      allow write: if false; // Apenas administradores via Firebase Console
    }
  }
}
